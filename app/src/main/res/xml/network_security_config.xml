<?xml version="1.0" encoding="utf-8"?>
<!-- WebView and model APIs use only the system roots. The private sync CA is
     loaded for the sync connection alone in SyncTls.kt. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
