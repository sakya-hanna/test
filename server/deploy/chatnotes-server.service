[Unit]
Description=ChatNotes Sync Server (Ktor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chatnotes
Group=chatnotes
WorkingDirectory=/opt/chatnotes
# 内存预算（设计 §12.3）：512m 堆封顶，4GB VPS 上与既有服务共存
Environment=CHATNOTES_PORT=8443
Environment=CHATNOTES_DB=/opt/chatnotes/data/chatnotes-server.db
Environment=CHATNOTES_KEYSTORE=/opt/chatnotes/server.p12
EnvironmentFile=/opt/chatnotes/keystore.env
# /admin 默认关闭；开启后浏览器使用 admin + 同步 token 登录。
#Environment=CHATNOTES_ADMIN=1
Environment=JAVA_TOOL_OPTIONS=-Xmx512m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m
ExecStart=/usr/bin/java -jar /opt/chatnotes/chatnotes-server.jar
Restart=on-failure
RestartSec=5
# 加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chatnotes/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
